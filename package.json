{
  "name": "theblinghaven",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:storefront": "npm run dev --workspace=apps/storefront",
    "build:all": "npm run build --workspaces",
    "lint:all": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
