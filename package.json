{
  "name": "theblinghaven",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@theblinghaven/shared && npm run build --workspace=@theblinghaven/api",
    "build:all": "npm run build --workspaces",
    "start": "npm run start:prod --workspace=@theblinghaven/api",
    "start:prod": "npm run start:prod --workspace=@theblinghaven/api",
    "dev:api": "npm run dev --workspace=@theblinghaven/api",
    "dev:admin": "npm run dev --workspace=@theblinghaven/admin",
    "dev:web": "npm run dev --workspace=@theblinghaven/web",
    "prisma:generate": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=apps/api/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=apps/api/prisma/schema.prisma",
    "lint:all": "npm run lint --workspaces",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.4.5"
  }
}
